# ─── PARADELLE CHOCOLATES — environment template (never commit real secrets) ──

# Database — Supabase pooled Postgres URI in production
# (Settings → Database → Connection string → "Transaction" pooler, port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin bootstrap/recovery — set only in a secure shell; never commit real passwords
ADMIN_EMAIL=admin@paradelle.store
ADMIN_INITIAL_PASSWORD=
ADMIN_RESET_EMAIL=admin@paradelle.store
ADMIN_RESET_PASSWORD=

# Site and search analytics (leave verification/measurement IDs blank until provided)
NEXT_PUBLIC_SITE_URL=https://paradelle.store
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (Phase 2/3 — Storage bucket "product-media"; future Auth bridge)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Razorpay — TEST keys in development (rzp_test_…), LIVE keys only in production.
# Server-side only:
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Browser-facing (Checkout.js):
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Transactional email — Resend (any SMTP/API provider can replace it in src/lib/email.ts)
RESEND_API_KEY=
RESEND_FROM="PARADELLE CHOCOLATES <orders@paradelle.store>"
CONTACT_NOTIFICATION_EMAIL=tejassutar.business@gmail.com
ENABLE_INBOUND_EMAIL_NOTIFICATIONS=false

# Optional: production rate limiting (replace in-memory buckets)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
